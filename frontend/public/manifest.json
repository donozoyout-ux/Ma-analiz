      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "AI Tahminleri",
      "short_name": "Tahminler",
      "description": "Yapay zekâ maç analizleri ve kuponlar",
      "url": "/predictions",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Bildirim Ayarları",
      "short_name": "Bildirimler",
      "description": "Gol, maç başlangıcı ve AI bildirim ayarları",
