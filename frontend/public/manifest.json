{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Maç Analiz - Futbol Veri ve Analiz Platformu",
  "short_name": "Maç Analiz",
  "description": "Gerçek maç verileri, oran hareketleri, anlık bildirimler ve kanıta dayalı futbol analizi.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
