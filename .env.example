APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
MATCH_PROVIDER=goaloo
PROVIDER_NAME=goaloo
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_REQUEST_TIMEOUT_SECONDS=15
PROVIDER_REQUESTS_PER_MINUTE=6
PROVIDER_MAX_RETRIES=1
# WEB SCRAPING FIRST: paid-provider configuration is retired.
GOALOO_BASE_URL=https://football.goaloo.com
GOALOO_ODDS_BASE_URL=https://www.goaloo.com
ENABLED_LEAGUES=8
ENABLED_SEASONS=2026-2027
HISTORICAL_START_DATE=2023-07-01
HISTORICAL_COLLECT_ODDS=false
DATABASE_URL=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sports-analytics
R2_REGION=auto
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_PROVIDER=groq
AI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
WORKER_INTERVAL_SECONDS=300
POSTGRES_NORMAL_MB=300
POSTGRES_WARNING_MB=500
POSTGRES_HIGH_MB=750
POSTGRES_CRITICAL_MB=750
JOB_HISTORY_RETENTION_DAYS=30
ACTIVE_STATE_RETENTION_DAYS=2
ODDS_RETENTION_DAYS=2
OPERATIONAL_RETENTION_HOURS=48
# Cleanup scheduler produces plans only. Keep deletion disabled for stage 4.
OPERATIONAL_DELETE_ENABLED=false
WORKER_ARCHIVE_INTERVAL_SECONDS=900
WORKER_CLEANUP_INTERVAL_SECONDS=3600
LIFECYCLE_BATCH_SIZE=25
LIFECYCLE_CHILD_LIMIT=500

# Optional protected /system connection checks. Generate a unique random secret
# of at least 32 characters; configure on the Render web service only.
# Never use a NEXT_PUBLIC_ variable for this secret.
SYSTEM_DIAGNOSTICS_TOKEN=

# Optional: pin a fingerprint independently verified against the intended database.
# Leave empty until verified. Token rotation changes the fingerprint.
SYSTEM_EXPECTED_DATABASE_FINGERPRINT=
