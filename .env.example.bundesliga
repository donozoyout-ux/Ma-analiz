# Bundesliga 32-hour Ingestion Configuration
# Copy this file to .env and fill in production values

APP_ENV=production
LOG_LEVEL=INFO

# Bundesliga-specific provider configuration (OpenLigaDB is free, no API key needed)
MATCH_PROVIDER=openligadb
PROVIDER_NAME=openligadb
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_REQUEST_TIMEOUT_SECONDS=10
PROVIDER_REQUESTS_PER_MINUTE=1
PROVIDER_MAX_RETRIES=3

# Enable Bundesliga ingestion
BUNDESLIGA_INGEST_ENABLED=true
BUNDESLIGA_INGEST_DRY_RUN=true
BUNDESLIGA_DAILY_MAX_REQUESTS=15
BUNDESLIGA_DAILY_MAX_R2_WRITES=50
BUNDESLIGA_DAILY_MAX_ARCHIVE_MB=50
BUNDESLIGA_DAILY_MAX_MATCHES=50

# Enabled Leagues (OpenLigaDB uses numeric IDs)
ENABLED_LEAGUES=de.bl1
ENABLED_SEASONS=2026-2027

# Historical settings
HISTORICAL_START_DATE=2026-07-01
HISTORICAL_COLLECT_ODDS=false

# 32-hour retention window (as requested)
OPERATIONAL_RETENTION_HOURS=32

# SAFETY: Production deletion is DISABLED by default (dry-run mode)
OPERATIONAL_DELETE_ENABLED=false
AUTO_RETENTION_DELETE_ENABLED=false

# R2 Cloudflare storage configuration
DATABASE_URL=postgresql+psycopg://localhost:5432/ma_analiz
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=sports-analytics
R2_REGION=auto

# Worker settings
WORKER_INTERVAL_SECONDS=300
WORKER_ARCHIVE_INTERVAL_SECONDS=900
WORKER_CLEANUP_INTERVAL_SECONDS=3600

# Lifecycle management
LIFECYCLE_BATCH_SIZE=25
LIFECYCLE_CHILD_LIMIT=500

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=